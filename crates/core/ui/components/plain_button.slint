import { Theme } from "../theme.slint";
import { Constants } from "../constants.slint";
import { KeyGlyph } from "key_glyph.slint";

// Button without pressed, hover, or animated styles. Each would be an e-ink
// update that delays the screen change the tap causes (about 0.5 s for Show
// Answer on the PB710); that change is the feedback.
//
// It fills the space it gets. `outlined` adds a border for buttons that are
// not part of an edge-to-edge bar; `primary` is the filled button. The key
// glyphs sit before the label.
export component PlainButton {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> outlined: false;
    in property <bool> primary: false;
    in property <bool> key-prev: false;
    in property <bool> key-next: false;
    callback clicked <=> touch.clicked;
    min-width: layout.min-width + 2 * Constants.spacing_m;
    min-height: Constants.bar_height;

    Rectangle {
        border-width: root.outlined || root.primary ? Constants.hairline : 0px;
        border-color: root.enabled ? Theme.line : Theme.muted;
        background: root.primary && root.enabled ? Theme.ink : Theme.paper;
    }

    layout := HorizontalLayout {
        alignment: center;
        spacing: Constants.spacing_s;
        if root.key-prev: VerticalLayout {
            alignment: center;
            KeyGlyph {
                next: false;
            }
        }
        if root.key-next: VerticalLayout {
            alignment: center;
            KeyGlyph {
                next: true;
            }
        }
        Text {
            text: root.text;
            font-family: Constants.font_family_standard;
            font-size: Constants.font_size_content;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
            color: !root.enabled ? Theme.muted : root.primary ? Theme.paper : Theme.ink;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
    }
}
