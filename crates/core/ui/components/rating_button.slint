import { Palette } from "std-widgets.slint";

export component RatingButton {
    in property <string> duration;
    in property <color> color;
    in property <string> label;
    in property <bool> enabled: true;
    out property <bool> pressed: self.enabled && touch.pressed;
    callback clicked <=> touch.clicked;
    min-width: max(32px, layout.min-width);
    min-height: max(32px, layout.min-height);
    // No pressed, hover, or animated styles: each would be an e-ink update
    // that delays the next card (0.5-0.8 s on the PB710). The next card is the
    // feedback.
    background := Rectangle {
        border-radius: 4px;
        background: Palette.control-background;
        border := Rectangle {
            border-radius: parent.border-radius;
            border-width: 1px;
            border-color: Palette.border;
        }

        layout := VerticalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 5px;
            padding-bottom: 5px;
            alignment: center;
            Text {
                text: root.duration;
                font-family: "Monospace";
                font-size: 14px;
                font-weight: 400;
                horizontal-alignment: center;
                vertical-alignment: center;
                color: color;
            }

            Text {
                text: root.label;
                font-size: 14px;
                font-weight: 400;
                horizontal-alignment: center;
                vertical-alignment: center;
                color: Palette.foreground;
            }
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
    }
}
