import { Theme } from "../theme.slint";
import { Constants } from "../constants.slint";
import { IconButton } from "icon_button.slint";

// Edge-to-edge bar: an optional back button, a title, and the children on the
// right. The icons of 44 px buttons line up with the 20 px screen padding.
export component TopBar {
    in property <string> title;
    in property <bool> has-back: false;
    callback back();
    height: Constants.bar_height;

    HorizontalLayout {
        padding-left: root.has-back ? Constants.padding_standard - 10px : Constants.padding_standard;
        padding-right: Constants.padding_standard - 10px;
        if root.has-back: IconButton {
            icon: @image-url("../icons/back.svg");
            clicked => {
                root.back();
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.title;
            font-family: Constants.font_family_standard;
            font-size: Constants.font_size_content;
            font-weight: 700;
            color: Theme.ink;
            vertical-alignment: center;
            overflow: elide;
        }

        HorizontalLayout {
            alignment: end;
            @children
        }
    }

    Rectangle {
        y: parent.height - self.height;
        height: Constants.hairline;
        background: Theme.line;
    }
}
