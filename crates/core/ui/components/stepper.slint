import { Theme } from "../theme.slint";
import { Constants } from "../constants.slint";
import { IconButton } from "icon_button.slint";

// Previous and next buttons around one of a list of labels, in a box. It
// wraps at both ends.
export component Stepper {
    in property <[string]> labels;
    in-out property <int> index;
    callback changed(index: int);
    height: Constants.bar_height;

    function step(delta: int) {
        if root.labels.length > 0 {
            root.index = Math.mod(root.index + delta + root.labels.length, root.labels.length);
            root.changed(root.index);
        }
    }

    Rectangle {
        border-width: Constants.hairline;
        border-color: Theme.line;
    }

    HorizontalLayout {
        IconButton {
            width: 40px;
            icon: @image-url("../icons/prev.svg");
            clicked => {
                root.step(-1);
            }
        }

        Text {
            horizontal-stretch: 1;
            text: root.index >= 0 && root.index < root.labels.length ? root.labels[root.index] : "";
            font-family: Constants.font_family_standard;
            font-size: Constants.font_size_content;
            color: Theme.ink;
            vertical-alignment: center;
            horizontal-alignment: center;
            overflow: elide;
        }

        IconButton {
            width: 40px;
            icon: @image-url("../icons/next.svg");
            clicked => {
                root.step(1);
            }
        }
    }
}
