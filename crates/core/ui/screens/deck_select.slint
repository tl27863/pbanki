import { Theme } from "../theme.slint";
import { Constants, Translations } from "../constants.slint";
import { DeckNode, HwKey, SyncState } from "../types.slint";
import { DeckRow } from "../components/deck_row.slint";
import { TopBar } from "../components/top_bar.slint";
import { IconButton } from "../components/icon_button.slint";
import { Pager } from "../components/pager.slint";
import { ActivityIcon, ActivityKind } from "../components/activity_icon.slint";

// The sync button is also the sync indicator: it animates in place during a
// sync and ends on done or error. The error text is on Settings > Sync.
component SyncButton {
    in property <SyncState> sync_state;
    callback clicked <=> touch.clicked;
    width: Constants.bar_height;
    height: Constants.bar_height;

    ActivityIcon {
        kind: root.sync_state.is_syncing ? ActivityKind.sync : root.sync_state.has_error || root.sync_state.has_warning ? ActivityKind.error : root.sync_state.done ? ActivityKind.done : ActivityKind.sync;
        animated: root.sync_state.is_syncing;
    }

    touch := TouchArea { }
}

component ColumnLabel inherits Text {
    width: 40px;
    font-family: Constants.font_family_standard;
    font-size: Constants.font_size_caption;
    color: Theme.muted;
    horizontal-alignment: right;
    vertical-alignment: center;
}

// Home: top bar, the column header, one fixed page of deck rows, and the
// pager. Nothing scrolls. Rust builds the page (`frontend/decks.rs`).
export component DeckSelectScreen {
    in property <Translations> tr;
    in property <SyncState> sync_state;
    in property <[DeckNode]> page-rows;
    in property <int> page;
    in property <int> page-count;

    callback deck_clicked(deck: DeckNode);
    callback deck_toggle(deck: DeckNode);
    callback stats_clicked(deck: DeckNode);
    callback page_changed(delta: int);
    callback settings_clicked();
    callback sync_clicked();

    forward-focus: focus-scope;

    // Key focus for the Prev and Next keys. From a timer, not `init`: see
    // the lint rule `pbanki-no-focus-in-init`.
    Timer {
        interval: 1ms;
        running: true;
        triggered => {
            self.running = false;
            focus-scope.focus();
        }
    }

    focus-scope := FocusScope {
        key-pressed(event) => {
            if event.text == Key.LeftArrow || event.text == Key.DownArrow || event.text == Key.PageDown {
                root.page_changed(-1);
                return accept;
            }
            if event.text == Key.RightArrow || event.text == Key.UpArrow || event.text == Key.PageUp {
                root.page_changed(1);
                return accept;
            }
            reject
        }

        VerticalLayout {
            TopBar {
                title: "pbAnki";
                SyncButton {
                    sync_state: root.sync_state;
                    clicked => {
                        if root.sync_state.has_error || root.sync_state.has_warning {
                            root.settings_clicked();
                        } else if !root.sync_state.is_syncing {
                            root.sync_clicked();
                        }
                    }
                }

                IconButton {
                    icon: @image-url("../icons/settings.svg");
                    clicked => {
                        root.settings_clicked();
                    }
                }
            }

            header := HorizontalLayout {
                height: Constants.home_header_height;
                alignment: end;
                // The stats button column of the rows.
                padding-right: Constants.padding_standard - 10px + Constants.bar_height;
                ColumnLabel {
                    text: root.tr.count_new;
                }

                ColumnLabel {
                    text: root.tr.count_learn;
                }

                ColumnLabel {
                    text: root.tr.count_due;
                }
            }

            VerticalLayout {
                vertical-stretch: 1;
                alignment: start;
                for deck in root.page-rows: DeckRow {
                    deck: deck;
                    toggle => {
                        root.deck_toggle(deck);
                    }
                    deck_clicked => {
                        root.deck_clicked(deck);
                    }
                    stats_clicked => {
                        root.stats_clicked(deck);
                    }
                }
            }

            Pager {
                page: root.page;
                page-count: root.page-count;
                changed(delta) => {
                    root.page_changed(delta);
                }
            }
        }
    }
}
