import { Constants, Translations } from "../constants.slint";
import { DeviceSettings, EditField, SyncSettings, SyncState } from "../types.slint";
import { TabHeader } from "../components/tab_header.slint";
import { SettingsSync } from "settings_sync.slint";
import { SettingsDevice } from "settings_device.slint";

// Settings: the tab header and the Sync (0) and Device (1) tabs.
export component SettingsScreen {
    in property <Translations> tr;
    in-out property <int> tab;
    in-out property <SyncSettings> settings;
    in-out property <DeviceSettings> device;
    in property <SyncState> sync_state;
    in property <bool> native-keyboard: false;
    // The device can play sound (`FrontendHooks::audio`).
    in property <bool> audio-supported: false;

    callback back();
    callback save(SyncSettings);
    callback save-device(DeviceSettings);
    callback sync-now();
    callback full-sync(upload: bool);
    callback edit-field(field: EditField, current: string);

    VerticalLayout {
        TabHeader {
            tabs: ["Sync", "Device"];
            current <=> root.tab;
            back => {
                root.back();
            }
        }

        if root.tab == 0: SettingsSync {
            vertical-stretch: 1;
            tr: root.tr;
            settings <=> root.settings;
            sync_state: root.sync_state;
            native-keyboard: root.native-keyboard;
            save(settings) => {
                root.save(settings);
            }
            sync-now => {
                root.sync-now();
            }
            full-sync(upload) => {
                root.full-sync(upload);
            }
            edit-field(field, current) => {
                root.edit-field(field, current);
            }
        }

        if root.tab != 0: SettingsDevice {
            vertical-stretch: 1;
            tr: root.tr;
            settings <=> root.device;
            audio-supported: root.audio-supported;
            save(settings) => {
                root.save-device(settings);
            }
        }
    }
}
