import { Theme } from "../theme.slint";
import { Constants, Translations } from "../constants.slint";
import { CardNode, HwKey, KeyAction, KeyHints } from "../types.slint";
import { PlainButton } from "../components/plain_button.slint";
import { RatingButton } from "../components/rating_button.slint";
import { TopBar } from "../components/top_bar.slint";
import { IconButton } from "../components/icon_button.slint";
import { KeyGlyph } from "../components/key_glyph.slint";
import { Loader } from "../components/loader.slint";
import { ActivityIcon, ActivityKind } from "../components/activity_icon.slint";

component StudyCount inherits Text {
    font-family: Constants.font_family_standard;
    font-size: Constants.font_size_subcontent;
    font-weight: 700;
    vertical-alignment: center;
    horizontal-alignment: right;
}

export component LearnScreen {
    in property <Translations> tr;
    in property <CardNode> card;
    in property <length> card-area-height;
    in property <int> page-version;
    // Deck entry: the full-screen loader.
    in property <bool> loading: false;
    // Rating: the loading icon in the top bar. The answered card stays.
    in property <bool> card-loading: false;
    // A card job owns the collection. Study buttons are disabled so taps meant
    // for the next card are not swallowed by the previous card's buttons (and
    // their press feedback does not add panel updates).
    in property <bool> busy: false;
    in property <KeyHints> key-hints;
    // The shown side has sounds: the replay button shows.
    in property <bool> has-audio: false;
    in property <bool> audio-playing: false;
    // Shown in the top bar, e.g. that there is no audio output.
    in property <string> audio-message;
    // Both are reset from Rust before a new card is set, so the first frame
    // of a card already shows its question page 1.
    in-out property <bool> show_answer;
    in-out property <int> current-page: 0;
    property <bool> valid_deck: card.id != (-1 * 1ms);
    // 0 when the card area shows `card.message` instead of pages.
    property <int> side-pages: show_answer ? card.answer-pages : card.question-pages;
    property <int> total-pages: max(1, side-pages);
    // Each key turns the page until its end of the side. While it does, its
    // glyph sits beside the page indicator; at its end, on the control it
    // triggers (`keys.rs` `resolve`).
    property <bool> prev-turns-page: current-page > 0;
    property <bool> next-turns-page: current-page < total-pages - 1;

    callback home_clicked();
    callback rate(rating: int);
    // A hardware key. Rust resolves it to a page turn, Show answer, or a
    // rating (`keys.rs`) from the configured actions.
    callback study-key(key: HwKey);
    pure callback page-image(answer: bool, page: int, version: int) -> image;
    callback answer-shown();
    callback replay-audio();

    // Show answer opens the page with Anki's `#answer` marker, not page 1:
    // the answer usually repeats the question first.
    function reveal() {
        current-page = card.answer-start;
        show_answer = true;
        answer-shown();
    }

    forward-focus: focus-scope;

    // Take key focus (page/rating keys) once, from a timer rather than `init`:
    // deck entry creates this screen while the window layout is being
    // evaluated, and focusing inside `init` re-enters that geometry binding
    // (Slint panics with "Recursion detected").
    focus-timer := Timer {
        interval: 1ms;
        running: true;
        triggered => {
            self.running = false;
            focus-scope.focus();
        }
    }

    focus-scope := FocusScope {
        key-pressed(event) => {
            if event.text == Key.LeftArrow || event.text == Key.DownArrow || event.text == Key.PageDown {
                root.study-key(HwKey.prev);
                return accept;
            }
            if event.text == Key.RightArrow || event.text == Key.UpArrow || event.text == Key.PageUp || event.text == Key.Return || event.text == Key.Menu {
                root.study-key(HwKey.next);
                return accept;
            }
            reject
        }

        if loading: Loader {
            text: "Loading deck";
        }

        if !loading: VerticalLayout {
            TopBar {
                has-back: true;
                title: root.audio-message;
                back => {
                    root.home_clicked();
                }

                // Replay, or stop while playing. Disabled (no icon) while a
                // job runs, like the study buttons.
                if root.has-audio && valid_deck: IconButton {
                    icon: root.audio-playing ? @image-url("../icons/audio_stop.svg") : @image-url("../icons/audio.svg");
                    enabled: !root.busy;
                    clicked => {
                        root.replay-audio();
                    }
                }

                HorizontalLayout {
                    padding-right: 10px;
                    spacing: Constants.spacing_m;
                    // The activity slot. It keeps its place when empty.
                    VerticalLayout {
                        alignment: center;
                        width: Constants.icon_size;
                        if root.card-loading: ActivityIcon {
                            kind: ActivityKind.loading;
                        }
                    }

                    StudyCount {
                        text: card.deck.new;
                        color: Theme.count-new;
                    }

                    StudyCount {
                        text: card.deck.learn;
                        color: Theme.count-learn;
                    }

                    StudyCount {
                        text: card.deck.due;
                        color: Theme.count-due;
                    }
                }
            }

            // The card area keeps the 20 px padding on all sides: the page
            // size is `MainWindow.card-area-width/height`.
            Rectangle {
                height: Constants.padding_standard;
            }

            HorizontalLayout {
                height: card-area-height;
                padding-left: Constants.padding_standard;
                padding-right: Constants.padding_standard;
                sgr := SwipeGestureHandler {
                    handle-swipe-down: current-page > 0;
                    handle-swipe-up: current-page < total-pages - 1;
                    swiped => {
                        if self.current-position.y > self.pressed-position.y + self.height / 4 {
                            if current-page > 0 {
                                current-page -= 1;
                            }
                        } else if self.current-position.y < self.pressed-position.y - self.height / 4 {
                            if current-page < total-pages - 1 {
                                current-page += 1;
                            }
                        }
                    }

                    Rectangle {
                        clip: true;

                        // The page is rendered at the physical size of this
                        // area, so it is drawn 1:1 (`phx`), with no scaling.
                        if side-pages > 0: Image {
                            x: 0;
                            y: 0;
                            source: root.page-image(show_answer, current-page, page-version);
                            width: self.source.width * 1phx;
                            height: self.source.height * 1phx;
                            image-rendering: pixelated;
                        }

                        if side-pages == 0: Text {
                            width: parent.width;
                            height: parent.height;
                            text: card.message;
                            font-family: Constants.font_family_standard;
                            font-size: Constants.font_size_content;
                            color: Theme.ink;
                            wrap: TextWrap.word-wrap;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }
                }
            }

            // The padding below the card holds the page indicator.
            HorizontalLayout {
                height: Constants.padding_standard;
                padding-right: Constants.padding_standard;
                alignment: end;
                spacing: Constants.spacing_xs;
                if total-pages > 1: VerticalLayout {
                    alignment: center;
                    // Hidden, not removed: the indicator keeps its place.
                    KeyGlyph {
                        next: false;
                        size: 16px;
                        visible: root.prev-turns-page;
                    }
                }
                if total-pages > 1: Text {
                    text: (current-page + 1) + " / " + total-pages;
                    font-family: Constants.font_family_standard;
                    font-size: Constants.font_size_caption;
                    color: Theme.ink;
                    vertical-alignment: center;
                }
                if total-pages > 1: VerticalLayout {
                    alignment: center;
                    KeyGlyph {
                        next: true;
                        size: 16px;
                        visible: root.next-turns-page;
                    }
                }
            }

            // The answer bar: full width, a hairline on top.
            Rectangle {
                height: Constants.answer_bar_height;

                if valid_deck && !show_answer: PlainButton {
                    width: 100%;
                    height: 100%;
                    text: tr.show-answer;
                    enabled: !busy;

                    key-prev: !root.prev-turns-page && root.key-hints.prev_question == KeyAction.show-answer;
                    key-next: !root.next-turns-page && root.key-hints.next_question == KeyAction.show-answer;

                    clicked => {
                        reveal();
                    }
                }

                if valid_deck && show_answer: HorizontalLayout {
                    for rating in 4: RatingButton {
                        // Four equal buttons, whatever their labels.
                        width: root.width / 4;
                        duration: card.durations[rating];
                        label: rating == 0 ? tr.again : rating == 1 ? tr.hard : rating == 2 ? tr.good : tr.easy;
                        color: rating == 0 ? Theme.rate-again : rating == 1 ? Theme.rate-hard : rating == 2 ? Theme.rate-good : Theme.rate-easy;
                        enabled: !busy;
                        separator: rating > 0;

                        property <KeyAction> action: rating == 0 ? KeyAction.again : rating == 1 ? KeyAction.hard : rating == 2 ? KeyAction.good : KeyAction.easy;
                        key-prev: !root.prev-turns-page && root.key-hints.prev_answer == self.action;
                        key-next: !root.next-turns-page && root.key-hints.next_answer == self.action;

                        clicked => {
                            rate(rating);
                        }
                    }
                }

                Rectangle {
                    y: 0;
                    height: Constants.hairline;
                    background: Theme.line;
                }
            }
        }
    }
}
