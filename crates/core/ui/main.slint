import { Constants, Translations } from "constants.slint";
import { DeckNode, DeckTree, CardNode, EditField, SyncSettings, SyncState } from "types.slint";
import { LearnScreen } from "screens/learn.slint";
import { DeckSelectScreen } from "screens/deck_select.slint";
import { SettingsScreen } from "screens/settings.slint";

export component MainWindow inherits Window {
    preferred-width: 500px;
    preferred-height: 400px;
    // Text without its own font-family (std-widgets CheckBox and Button labels)
    // uses the runtime UI font, not a glyph set embedded at build time.
    default-font-family: Constants.font_family_standard;
    in property <Translations> tr;

    in-out property <bool> learning;
    in-out property <CardNode> current_card;
    // True from the moment a card job or sync starts until it finishes. Unlike
    // `loading`, this is set immediately and is never deferred, so navigation
    // can be guarded while a card job owns the collection or a sync is running.
    in-out property <bool> busy: false;
    in-out property <bool> loading: false;
    in-out property <string> loading_message: "Loading...";

    in-out property <DeckTree> deck_tree;
    in-out property <bool> settings_open;
    in-out property <SyncSettings> sync_settings;
    in-out property <SyncState> sync_state;
    in property <bool> native_keyboard: false;

    // The card area of the study screen. Rust renders the card pages for this
    // size (times the scale factor) before `LearnScreen` exists.
    out property <length> card-area-width: root.width - 2 * Constants.padding_standard;
    out property <length> card-area-height: root.height - 2 * Constants.padding_standard - Constants.study_menu_height - Constants.study_buttons_height;
    // Study page state, set from Rust when a new card arrives.
    in-out property <bool> show-answer;
    in-out property <int> study-page;
    // Changes when a page that was not ready arrives (see `page-image`).
    in property <int> page-version;

    callback update_deck_tree();
    callback deck_clicked(deck: DeckNode);
    callback rate(rating: int, deck: DeckNode);
    // The image of one card page. `version` only makes the binding run again.
    pure callback page-image(answer: bool, page: int, version: int) -> image;
    callback open_settings();
    callback save_settings(settings: SyncSettings);
    callback sync_now();
    callback full_sync(upload: bool);
    callback settings_back();
    callback edit_field(field: EditField, current: string);
    callback session_ended();

    if settings_open: SettingsScreen {
        width: 100%;
        height: 100%;
        tr: tr;
        settings <=> sync_settings;
        sync_state: sync_state;
        native-keyboard: native_keyboard;
        back => {
            settings_back();
        }
        save(settings) => {
            save_settings(settings);
        }
        sync-now => {
            sync_now();
        }
        full-sync(upload) => {
            full_sync(upload);
        }
        edit-field(field, current) => {
            edit_field(field, current);
        }
    }

    if !settings_open: VerticalLayout {
        padding: Constants.padding_standard;
        if !learning: DeckSelectScreen {
            tr: tr;
            due_total: deck_tree.due_total;
            deck_nodes: deck_tree.deck_nodes;
            sync_state: sync_state;
            deck_clicked(deck) => {
                // `learning` is set from Rust once the loading screen or the
                // card is ready, so the previous card is never shown.
                if !busy {
                    deck_clicked(deck);
                }
            }
            settings_clicked => {
                open_settings();
            }
            sync_clicked => {
                sync_now();
            }
        }
        if learning: LearnScreen {
            tr: tr;
            card: current_card;
            card-area-height: card-area-height;
            show_answer <=> root.show-answer;
            current-page <=> root.study-page;
            page-version: page-version;
            page-image(answer, page, version) => {
                return root.page-image(answer, page, version);
            }
            loading: loading;
            loading_message: loading_message;
            busy: busy;
            home_clicked => {
                if !busy {
                    update_deck_tree();
                    learning = false;
                    session_ended();
                }
            }
            rate(rating) => {
                rate(rating, current_card.deck);
            }
        }
    }
}
