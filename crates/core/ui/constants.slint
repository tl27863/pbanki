	easy: string,
	cards_due_suffix: string,
	no_cards_due: string,
	settings: string,
	back: string,
	save: string,
	sync_now: string,
	server_url: string,
	email: string,
	password: string,
	auto_sync: string,
	sync_on_exit: string,
	sync_media: string,
	upload: string,
	download: string,
	full_sync_required: string,
	confirm_full_sync: string,
	cancel: string,
}
