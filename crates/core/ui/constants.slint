export global Constants {
    out property <string> font_family_standard: "Monospace";

    out property <length> font_size_heading: 30px;
    out property <length> font_size_content: 20px;
    out property <length> font_size_subcontent: 15px;

    out property <length> font_size_caption: 12px;

    out property <length> padding_standard: 20px;
    out property <length> spacing_xs: 4px;
    out property <length> spacing_s: 8px;
    out property <length> spacing_m: 12px;
    out property <length> spacing_l: 20px;

    out property <length> hairline: 1px;
    out property <length> icon_size: 24px;
    // Top bar, tab header, pager, and the smallest touch target.
    out property <length> bar_height: 44px;
    out property <length> deck_row_height: 48px;
    // The column header (New, Learn, Due) above the deck rows.
    out property <length> home_header_height: 24px;
    // Fixed heights of the study screen rows are `bar_height` and
    // `answer_bar_height`. The card area gets the rest, and its size must be
    // known before the screen exists (the card is rendered for it on the
    // worker).
    out property <length> answer_bar_height: 84px;
}

export struct Translations {
	show_answer: string,
	again: string,
	hard: string,
	good: string,
	easy: string,
	count_new: string,
	count_learn: string,
	count_due: string,
	no_cards_due: string,
	settings: string,
	back: string,
	save: string,
	sync_now: string,
	server_url: string,
	email: string,
	password: string,
	auto_sync: string,
	sync_on_exit: string,
	sync_media: string,
	upload: string,
	download: string,
	full_sync_title: string,
	full_sync_required: string,
	confirm_full_sync: string,
	cancel: string,
}
