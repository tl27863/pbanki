export struct DeckNode {
	id: duration,
	name: string,
	level: int,
	collapsed: bool,
	new: int,
	learn: int,
	due: int,
	has_children: bool,
	parent_index: int,
}

export struct DeckTree {
	due_total: int,
	deck_nodes: [DeckNode],
}

export struct CardNode {
	id: duration,
	deck: DeckNode,
	question: [string],
	answer: [string],
	durations: [string],
}

export struct SyncSettings {
    endpoint: string,
    username: string,
    password: string,
    auto_sync: bool,
    sync_on_exit: bool,
    sync_media: bool,
}

export struct SyncState {
    is_syncing: bool,
    status_message: string,
    has_error: bool,
    has_warning: bool,
    full_sync_required: bool,
    can_upload: bool,
    can_download: bool,
}
